{
  "name": "repropack-cli",
  "version": "0.1.0",
  "description": "Create reviewable, redacted diagnostic reports from failing commands.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "zuythu3-sudo",
  "homepage": "https://github.com/zuythu3-sudo/repropack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuythu3-sudo/repropack.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/zuythu3-sudo/repropack/issues"
  },
  "keywords": [
    "diagnostics",
    "debugging",
    "cli",
    "redaction",
    "privacy",
    "bug-report",
    "reproducibility"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repropack": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/repropack.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
