{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/zuythu3-sudo/repropack/v0.1.0/packages/cli/schema/repropack.schema.json",
  "title": "ReproPack diagnostic report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "createdAt",
    "command",
    "environment",
    "output",
    "redaction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "repropack" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "exitCode", "signal", "durationMs", "timedOut"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 8192 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"], "maxLength": 32 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "timedOut": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "release", "arch", "nodeVersion", "npmVersion"],
      "properties": {
        "platform": { "enum": ["aix", "darwin", "freebsd", "linux", "openbsd", "sunos", "win32"] },
        "release": { "type": "string", "maxLength": 256 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "npmVersion": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "packageManager", "lockfile"],
      "properties": {
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
        "dirty": { "type": ["boolean", "null"] },
        "packageManager": { "type": ["string", "null"], "maxLength": 64 },
        "lockfile": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "sha256"],
              "properties": {
                "name": { "enum": ["package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "yarn.lock"] },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr", "stdoutTruncated", "stderrTruncated", "encodingIssues"],
      "properties": {
        "stdout": { "type": "string", "maxLength": 1048576 },
        "stderr": { "type": "string", "maxLength": 1048576 },
        "stdoutTruncated": { "type": "boolean" },
        "stderrTruncated": { "type": "boolean" },
        "encodingIssues": { "type": "boolean" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "categories", "residualWarnings"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "categories": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z-]{0,63}$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "residualWarnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 256 }
        }
      }
    }
  }
}
